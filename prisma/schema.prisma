// Persistence for saved workflows and their run history.
//
// SQLite has no JSON column type, so graph documents and node outputs are
// stored as JSON text and parsed at the data-access boundary.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  /// Serialized { nodes, edges } — the current, editable definition.
  document  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs Run[]

  @@index([updatedAt])
}

model Run {
  id String @id @default(cuid())

  /// Null once the workflow is deleted; the run and its snapshot survive.
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  /// Name at the time of the run, so history stays readable after a rename.
  workflowName String

  /// The graph exactly as executed. Kept separate from Workflow.document so
  /// history stays truthful after the workflow is edited, and so a replay
  /// re-runs what actually ran rather than what the workflow says today.
  document String

  /// queued | running | awaiting_approval | success | error | cancelled
  ///
  /// `queued` and `awaiting_approval` are not yet reachable — the run still
  /// starts executing inside the request. They exist now so the worker in the
  /// next step is a code change rather than another migration.
  status     String
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  /// Worker lease. A run is claimed by exactly one worker at a time; an expired
  /// lease means that worker died and the run may be reclaimed. Unused until
  /// execution moves out of the request, but claimed here so the column exists
  /// before anything depends on it.
  claimedBy      String?
  leaseExpiresAt DateTime?

  steps  RunStep[]
  events RunEvent[]

  @@index([startedAt])
  @@index([workflowId])
  /// The worker's claim query and the stale-run sweep both filter on these.
  @@index([status, leaseExpiresAt])
}

/// Append-only execution history: one row per state change, in the order the
/// engine produced them.
///
/// This is the canonical record of a run. `RunStep` holds the *current* state
/// of each node and is a projection of these events — if the two ever
/// disagree, this table is right. Replaying from a cursor is what lets a
/// client reconnect without losing anything, and what lets an interrupted run
/// be reconstructed rather than guessed at.
///
/// Rows are never updated and never deleted individually; they go away only
/// with their run.
model RunEvent {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Position within the run, starting at 1. Assigned by a single serialised
  /// writer, so it is dense and strictly increasing. Doubles as the SSE cursor.
  seq Int

  /// RunEvent type, e.g. "node:started". Deliberately a string rather than an
  /// enum: adding an event type should not require a migration, and readers
  /// must tolerate types they do not know.
  type String

  /// Null for run-level events.
  nodeId String?

  /// Serialized event body. JSON text, since SQLite has no JSON column type.
  payload String

  createdAt DateTime @default(now())

  @@unique([runId, seq])
}

model RunStep {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeKind String
  /// Execution position, so steps replay in the order they ran.
  position Int

  status     String // success | error | skipped
  /// Serialized value that arrived on this node's edges, for inspection.
  input      String?
  /// Serialized node output; null for failed or skipped steps.
  output     String?
  /// Serialized execution facts that are not the output itself: the branch a
  /// Condition took, why a node was skipped.
  metadata   String?
  error      String?
  durationMs Int?

  @@unique([runId, nodeId])
  @@index([runId, position])
}
