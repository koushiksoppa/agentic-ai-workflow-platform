# Copy to .env.local for secrets (gitignored, never committed).
# Anthropic API key for Model nodes. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# SQLite database. Read by both the Prisma CLI and Next, so this one belongs in
# .env rather than .env.local. Path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Local development only. Allows HTTP nodes to reach private, loopback and
# link-local addresses, which are blocked by default to prevent server-side
# request forgery. Leave unset unless you are calling a service on localhost.
# ALLOW_PRIVATE_NETWORK_REQUESTS=true
